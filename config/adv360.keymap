#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

&lt { tapping-term-ms = <140>; };

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <140>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <140>;
        };

        media: media {
            compatible = "zmk,behavior-hold-tap";
            label = "MEDIA";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
            flavor = "tap-preferred";
        };

        caps: caps {
            compatible = "zmk,behavior-tap-dance";
            label = "CAPS";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
        };

        lth: layer_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "LTH";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            tapping-term-ms = <140>;
            quick-tap-ms = <140>;
            flavor = "tap-preferred";
        };
    };

    macros {
        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
            label = "ARROW";
        };
    };

    combos {
        compatible = "zmk,combos";

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <32 31>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        alpha {
            bindings = <
&kp CAPSLOCK  &kp N1            &kp N2              &kp N3          &kp N4           &kp N5                       &tog 1                                                                                                                 &to 3                    &kp N6                       &kp N7           &kp N8          &kp N9              &kp N0                    &kp BACKSPACE
&kp TAB       &kp Q             &kp W               &kp E           &kp R            &kp T                        &kp LS(LA(LG(LC(F21))))                                                                                                &kp LS(LA(LC(LG(F22))))  &kp Y                        &kp U            &kp I           &kp O               &kp P                     &kp BSLH
&kp ESC       &hm LEFT_SHIFT A  &hm LEFT_CONTROL S  &hm LEFT_ALT D  &hm LEFT_META F  &hm LS(LA(LC(LEFT_META))) G  &kp PRINTSCREEN          &kp C_VOLUME_DOWN  &kp C_VOLUME_UP      &media C_REWIND C_PREV  &media C_FAST_FORWARD C_NEXT  &kp LS(LA(LC(LG(F23))))  &hm LS(LA(LC(LEFT_META))) H  &hm LEFT_META J  &hm LEFT_ALT K  &hm LEFT_CONTROL L  &hm LEFT_SHIFT SEMICOLON  &kp ENTER
&none         &kp Z             &kp X               &kp C           &kp V            &kp B                                                                    &kp DELETE           &kp C_PLAY_PAUSE                                                               &kp N                        &kp M            &kp COMMA       &kp DOT             &kp FSLH                  &kp RSHFT
&kp LCTRL     &kp LC(S)         &none               &kp KP_MINUS    &kp UNDERSCORE                                &lth 1 SPACE             &lth 2 TAB         &caps                &kp C_MUTE              &lth 2 BACKSPACE              &lth 1 SPACE                                          &kp TILDE        &kp EXCL        &kp CARET           &none                     &kp LEFT_META
            >;
        };

        symbols {
            bindings = <
&kp CAPSLOCK  &kp F1                           &kp F2                              &kp F3              &kp F4                       &kp F5            &kp F11                                                 &kp F12  &kp F6       &kp F7          &kp F8         &kp F9            &kp F10               &kp BACKSPACE
&kp TAB       &kp LEFT_BRACKET                 &kp RIGHT_BRACKET                   &kp PLUS            &kp ASTERISK                 &kp AMPS          &trans                                                  &trans   &kp AT_SIGN  &kp POUND       &kp DOLLAR     &kp BACKSLASH     &kp CARET             &kp PIPE
&kp ESC       &hm LEFT_SHIFT LEFT_PARENTHESIS  &hm LEFT_CONTROL RIGHT_PARENTHESIS  &hm LEFT_ALT EQUAL  &hm LEFT_META DOUBLE_QUOTES  &kp SINGLE_QUOTE  &trans   &trans  &trans      &trans             &trans  &trans   &kp LEFT     &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT         &hm LEFT_SHIFT COLON  &kp ENTER
&none         &kp LEFT_BRACE                   &kp RBRC                            &kp MINUS           &kp UNDERSCORE               &kp PIPE                           &trans      &kp C_RANDOM_PLAY                   &kp TILDE    &kp EXCL        &kp LESS_THAN  &kp GREATER_THAN  &kp QUESTION          &kp RSHFT
&trans        &kp HOME                         &kp PAGE_DOWN                       &kp PAGE_UP         &kp END                                        &trans   &trans  &trans      &trans             &trans  &trans                &kp PERCENT     &none          &none             &kp KP_SLASH          &kp LEFT_META
            >;
        };

        numbers {
            bindings = <
&none  &kp F11  &kp F12  &kp F13    &kp F14  &kp F15  &none                                       &none   &kp F16  &kp F17  &kp F18    &kp F19     &kp F20  &none
&none  &kp F21  &kp F22  &kp F23    &kp F24  &none    &none                                       &none   &none    &none    &none      &none       &none    &none
&none  &kp N1   &kp N2   &kp N3     &kp N4   &kp N5   &none   &trans  &trans      &trans  &trans  &none   &kp N6   &kp N7   &kp N8     &kp N9      &kp N0   &none
&none  &none    &none    &kp MINUS  &none    &none                    &trans      &trans                  &none    &none    &kp COMMA  &kp PERIOD  &none    &none
&none  &none    &none    &none      &none             &trans  &trans  &trans      &trans  &trans  &trans           &none    &none      &none       &none    &tog 4
            >;
        };

        settings {
            bindings = <
&bt BT_CLR       &bt BT_DISC 0    &bt BT_DISC 1    &bt BT_DISC 2    &bt BT_DISC 3    &bt BT_DISC 4    &to 0                                             &to 0                   &none  &none  &none  &none  &none  &studio_unlock
&none            &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &out OUT_BLE                                      &none                   &none  &none  &none  &none  &none  &none
&none            &bl BL_TOG       &bl BL_INC       &bl BL_DEC       &bl BL_SET 50    &bl BL_SET 100   &out OUT_USB  &trans  &trans      &trans  &trans  &rgb_ug RGB_MEFS_CMD 5  &none  &none  &none  &none  &none  &none
&rgb_ug RGB_EFF  &rgb_ug RGB_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI                        &trans      &trans                                  &none  &none  &none  &none  &none  &none
&rgb_ug RGB_EFR  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI                   &trans        &trans  &trans      &trans  &trans  &trans                         &none  &none  &none  &none  &bootloader
            >;
        };

        gaming {
            bindings = <
&kp GRAVE  &kp N1     &kp N2  &kp N3  &kp N4  &kp N5  &trans                                      &trans  &kp N6  &kp N7    &kp N8     &kp N9   &kp N0     &trans
&kp TAB    &kp Q      &kp W   &kp E   &kp R   &kp T   &trans                                      &trans  &kp Y   &kp U     &kp I      &kp O    &kp P      &kp BSLH
&kp TAB    &kp A      &kp S   &kp D   &kp F   &kp G   &trans  &trans  &trans      &trans  &trans  &trans  &kp H   &kp J     &kp K      &kp L    &kp SEMI   &kp RET
&trans     &kp Z      &kp X   &kp C   &kp V   &trans                  &trans      &trans                  &kp N   &kp M     &kp COMMA  &kp DOT  &kp FSLH   &trans
&trans     &kp LSHFT  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &kp LEFT  &kp DOWN   &kp UP   &kp RIGHT  &trans
            >;
        };
    };
};
